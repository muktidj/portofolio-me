---
import { sid, type Content, type Lang } from '../data/content';
import Icon from './Icon.astro';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const hero = c.hero;
const factIcons = ['briefcase', 'spark', 'code', 'people'];
---
<section id={sid('top', lang)} class="pt-16 pb-12 lg:pt-[72px]">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-[72px]">
      <div>
        <span class="pill"><Icon name="spark" size={16} /> Open to new opportunities</span>
        <h1 class="mt-8 mb-7 font-display text-[clamp(52px,7vw,96px)] leading-[1.05] font-bold tracking-tight">{hero.name}</h1>
        <p class="max-w-[900px] font-display text-[clamp(22px,2.6vw,34px)] leading-[1.3] font-semibold">{hero.roles}</p>
        <p class="mt-8 mb-10 max-w-[880px] text-lg text-ink-400 sm:text-[22px]">{hero.intro}</p>
        <div class="flex flex-wrap gap-4">
          <a class="btn btn-primary" href={'#' + sid('projects', lang)}>View My Work</a>
          <a class="btn btn-outline" href={'#' + sid('contact', lang)}>Let's Talk</a>
          <button type="button" class="btn btn-ghost" data-open-resume><Icon name="file" size={16} /> Resume</button>
        </div>
        <p class="mt-9 flex items-center gap-2 text-ink-400"><Icon name="pin" size={16} /> {hero.location}</p>
      </div>

      <div class="mx-auto grid w-full max-w-[500px] gap-5 lg:max-w-none">
        <figure class="relative aspect-[4/5] w-full overflow-hidden rounded-[28px] border border-ink-800 lg:max-h-[640px]">
          <img src="/mukti.jpg" alt={`Foto ${hero.name}`} width="400" height="400" class="size-full object-cover" fetchpriority="high" />
          <figcaption class="absolute inset-x-0 bottom-0 grid gap-0.5 bg-linear-to-t from-ink-950/90 to-transparent p-6">
            <strong><span class="dot"></span>Open to new opportunities</strong>
          </figcaption>
        </figure>
        <div class="grid grid-cols-2 gap-5">
          {hero.facts.map((f, i) => (
            <div class="card grid content-start gap-1.5 p-[22px]">
              <span class="text-accent-400"><Icon name={factIcons[i]} /></span>
              <small class="text-xs font-semibold tracking-widest text-ink-400 uppercase">{f.label}</small>
              <strong class="leading-snug">{f.value}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-6 lg:grid-cols-4">
      {hero.stats.map((s) => (
        <div class="card grid gap-1.5 p-7">
          <b class="font-display text-5xl leading-none text-accent-400 sm:text-[56px]">{s.value}</b>
          <small class="text-xs font-semibold tracking-widest text-ink-400 uppercase">{s.label}</small>
        </div>
      ))}
    </div>

    <div class="mt-20 border-t border-ink-800 pt-14">
      <p class="eyebrow justify-center">Industries I've worked with</p>
      <ul class="flex flex-wrap justify-center gap-x-14 gap-y-6 font-display text-2xl font-semibold text-ink-600">
        {hero.industries.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </div>
</section>
