---
import { type Content, type Lang } from '../data/content';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
interface Props { c: Content; lang: Lang }
const { c } = Astro.props;
const r = c.resume, h = c.hero, L = r.labels;
const h3 = 'mb-3.5 flex items-center gap-2 text-[18.5px] font-semibold uppercase tracking-[0.1em] text-[#8b93a5]';
const h3x = 'mb-[17px] flex items-center gap-2 text-[18.5px] font-semibold uppercase tracking-[0.1em] text-[#8b93a5]';
---
<dialog id="resume" aria-label="Resume"
  class="resume-dialog m-auto max-h-[calc(100dvh-2rem)] w-[min(1172px,calc(100%-1.5rem))] overflow-auto rounded-[20px] border-0 bg-white p-0 text-[#1a1f2b] backdrop:bg-ink-950/80 backdrop:backdrop-blur-sm sm:w-[min(1172px,calc(100%-3rem))]">
  <div class="no-print sticky top-0 z-[2] flex justify-end gap-2.5 border-b border-[#e8ebf0] bg-white/90 px-5 py-3.5 backdrop-blur-md">
    <button type="button" data-print class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-[#d5dae3] bg-white px-5 py-2.5 text-base font-semibold text-[#1a1f2b] hover:bg-[#f1f3f7]"><Icon name="download" size={16} /> {L.download}</button>
    <button type="button" data-close-resume aria-label={L.close} class="grid size-10 cursor-pointer place-items-center rounded-[10px] border border-[#d5dae3] bg-white text-[#1a1f2b] hover:bg-[#f1f3f7]"><Icon name="x" size={20} /></button>
  </div>
  <article class="px-[22px] pt-6 pb-8 text-base leading-[1.6] text-[#2a3140] sm:px-16 sm:pt-10 sm:pb-12 sm:text-lg">
    <header class="border-b-2 border-[#0b1020] pb-7">
      <h2 class="font-display text-4xl leading-[1.1] font-bold tracking-tight text-[#0b1020] sm:text-[49px]">{h.name}, {profile.degree}</h2>
      <p class="mt-2.5 text-[19px] leading-[1.35] text-[#4b5468] sm:text-[23.5px]">{h.roles}</p>
      <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-1 text-base text-[#5b6478] sm:text-lg">
        {r.contacts.map((x) => <li class="flex items-center gap-2"><Icon name={x.icon} size={18} /> {x.text}</li>)}
      </ul>
    </header>

    <section class="mt-[35px]">
      <h3 class={h3}>{L.summary}</h3>
      <p class="leading-[1.65]">{h.intro}</p>
    </section>

    <section class="mt-[35px]">
      <h3 class={h3}>{L.work}</h3>
      {c.experience.jobs.map((j) => (
        <div class="mb-[27px] last:mb-0">
          <div class="flex flex-col items-baseline justify-between gap-0.5 sm:flex-row sm:gap-4">
            <p class="text-lg sm:text-[21px]"><strong class="font-bold text-[#0b1020]">{j.role}</strong> · <span class="text-[#5b6478]">{j.company}</span></p>
            <span class="text-[15px] whitespace-nowrap text-[#8b93a5] sm:text-lg">{j.period}</span>
          </div>
          <p class="mt-[5px] mb-2.5 leading-[1.65]">{j.text}</p>
          <ul class="grid gap-1.5">
            {j.bullets.map((b) => <li class="relative pl-[18px] before:absolute before:top-[0.75em] before:left-0 before:size-[5px] before:rounded-full before:bg-[#aab1c0]">{b}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <div class="mt-[35px] grid gap-x-12 gap-y-9">
      <section>
        <h3 class={h3x}><Icon name="cap" size={16} /> {L.education}</h3>
        <div class="grid gap-x-12 gap-y-5 sm:grid-cols-2">
        {r.education.map((e) => (
          <div>
            <p class="leading-[1.65]"><strong class="font-bold text-[#0b1020]">{e.degree}</strong></p>
            <p class="text-base text-[#5b6478] sm:text-lg">{e.school}</p>
            {e.text && <p class="mt-1 text-[15.5px] text-[#6b7388]">{e.text}</p>}
          </div>
        ))}
        </div>
      </section>
    </div>

    <section class="mt-[35px]">
      <h3 class={h3x}>{L.skills}</h3>
      <div class="grid gap-x-12 sm:grid-cols-2">
        {r.skillGroups.map((g) => (
          <div>
            <h4 class="mb-2.5 text-[15px] font-semibold tracking-[0.08em] text-[#4b5468] uppercase">{g.title}</h4>
            <ul class="mb-3.5 flex flex-wrap gap-2">
              {g.items.map((i) => <li class="rounded-lg border border-[#d5dae3] bg-[#f7f8fa] px-3 py-[5px] text-sm text-[#2a3140]">{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-[35px]">
      <h3 class={h3x}>{L.additional}</h3>
      <p class="text-[15.5px] leading-[1.65] text-[#6b7388]">{r.additional.join(' · ')}</p>
    </section>

    <footer class="mt-8 border-t border-[#e8ebf0] pt-5 text-center text-[15.5px] text-[#9aa1b2]">{h.name} · {r.contacts[0].text} · {r.contacts[1].text} · {r.contacts[2].text}</footer>
  </article>
</dialog>
