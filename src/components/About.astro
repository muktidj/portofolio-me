---
import { sid, type Content, type Lang } from '../data/content';
import Icon from './Icon.astro';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const about = c.about;
const t = c.ui.about;
---
<section id={sid('about', lang)} class="section">
  <div class="container-x reveal">
    <p class="eyebrow"><span>{t.eyebrow}</span> <button type="button" class="chip" data-open-resume><Icon name="file" size={14} /> {t.viewResume}</button></p>
    <h2 class="title">{t.title} <em>{t.titleEm}</em></h2>
    <div class="mt-14 grid items-start gap-14 lg:grid-cols-[1.25fr_1fr]">
      <div class="grid gap-7">
        {about.paragraphs.map((p, i) => <p class:list={['text-lg leading-[1.7] lg:text-xl', i === 0 ? 'text-ink-100' : 'text-ink-400']}>{p}</p>)}
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {about.values.map((v) => (
          <article class="card flex flex-col p-7 pb-8 lg:min-h-[300px]">
            <span class="text-accent-400"><Icon name={v.icon} size={30} /></span>
            <h3 class="mt-9 mb-3 font-display text-[22px] leading-tight font-bold">{v.title}</h3>
            <p class="leading-[1.7] text-ink-400">{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
